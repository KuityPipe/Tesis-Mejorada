# Entornos virtuales
venv*/
*/venv/
fr-venv/
*/fr-venv/

# Python
__pycache__/
*.pyc
*.pyd

# Variables de entorno / secretos
.env

# Archivo de backup/export de GitHub (contiene datos personales, se deja fuera del tracking)
TesisAntigua/

# Cache regenerable (ej. texto extraído de PDFs para análisis) — no versionar
.sistema/cache/*
!.sistema/cache/.gitkeep

# Archivos subidos por usuarios (MEDIA_ROOT) — contenido en tiempo de ejecución,
# no código fuente; puede incluir datos personales (ej. CV/documentos subidos
# al probar la creación de publicaciones), nunca debe versionarse.
codigo/backend/django/media/
# Almacenamiento privado de Documento (ver KeyServApp/storage.py) — mismo
# criterio que MEDIA_ROOT, nunca versionar contenido subido por usuarios.
codigo/backend/django/media_privado/

# Destino de `collectstatic` (STATIC_ROOT, ver settings.py y render_build.sh)
# — generado en cada build de producción, no código fuente.
codigo/backend/django/staticfiles/

# Base de datos GeoIP local (~130 MB, ver KeyServApp/geolocalizacion.py) —
# se descarga con `manage.py descargar_geoip`, no es código fuente y se
# actualiza mensualmente sola, no tiene sentido versionarla.
codigo/backend/django/geoip/
