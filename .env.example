# Copiar este archivo a codigo/backend/django/.env y completar con valores
# reales. NUNCA commitear el .env real (ya está en .gitignore).

# --- Django ---
DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
# URL del panel de administración — cambiarla en producción reduce el ruido
# de bots que escanean "/admin/" al voleo (no reemplaza el login real).
# Debe terminar en "/".
DJANGO_ADMIN_URL=admin/

# --- API REST / Ionic-Angular (ver KeyServApp/api/ y plan de migración) ---
# Orígenes que pueden llamar /api/* — 'ionic serve' usa :8100 por defecto.
CORS_ALLOWED_ORIGINS=http://localhost:8100
# JWT_SECRET vacío = reusa DJANGO_SECRET_KEY (suficiente en dev). En
# producción, generar uno propio y distinto (rotar uno no invalida el otro).
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTOS=20
JWT_REFRESH_TOKEN_DIAS=30
# URL del frontend Ionic — usada para armar el link de recuperación de
# contraseña que se manda por correo desde la API (ver RecuperarView).
IONIC_FRONTEND_URL=http://localhost:8100

# --- Seguridad para producción (ver KeyServProject/settings.py) ---
# Todo lo de acá abajo se activa solo con DJANGO_DEBUG=False, no hace falta
# tocarlo salvo que el despliegue tenga alguna particularidad (ej. TLS
# terminado en un proxy en vez de en Django mismo).
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# HSTS apagado por defecto siempre — activar recién cuando el dominio real
# sirva HTTPS de forma consistente (ver el comentario en settings.py, mal
# configurado puede dejar el sitio inaccesible por el tiempo que se ponga acá).
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True

# --- Base de datos (PostgreSQL) ---
DB_NAME=keyserv
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- SMTP (envío de correo real: recuperación de contraseña — ver
# KeyServApp/views.recuperar_view — y también el código de verificación de
# codigo/biometria/huella/AUTENTIFICACION.py) ---
# IMPORTANTE: la versión anterior de AUTENTIFICACION.py tenía una contraseña
# de correo real hardcodeada en el código fuente (ya rotada/removida en esta
# fase, ver docs/archivo/CODE_QUALITY_IMPROVEMENTS.md) — usar SIEMPRE variables de
# entorno para esto de ahora en adelante.
# Sin SMTP_PASSWORD y con DJANGO_DEBUG=True, KeyServProject/settings.py usa
# el backend de consola (el correo se imprime en la terminal de `runserver`
# en vez de enviarse de verdad) — no hace falta completar esto para probar
# el flujo de /recuperar/ en desarrollo.
# Ejemplos (con verificación en dos pasos hace falta una "contraseña de aplicación", no la clave normal):
#   Gmail:   SMTP_HOST=smtp.gmail.com        SMTP_PORT=587   SMTP_USER=tu.cuenta@gmail.com
#   Outlook: SMTP_HOST=smtp-mail.outlook.com SMTP_PORT=587   SMTP_USER=tu.cuenta@outlook.com
#   Brevo/Resend/etc.: usa el host, el puerto y la clave SMTP que te dé el proveedor.
# DJANGO_DEFAULT_FROM_EMAIL debe ser la MISMA dirección de la cuenta SMTP (o un dominio verificado en el proveedor): si no,
# el servidor rechaza el envío o el correo cae en spam. Comprobar la configuración:  python manage.py probar_correo tu@correo.cl
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=KeyServ <no-responder@keyserv.cl>

# --- Pagos: Webpay Plus + Khipu (ver codigo/backend/django/KeyServApp/pagos.py) ---
# Webpay: con TRANSBANK_ENVIRONMENT=integracion (default) no hace falta
# completar nada más — pagos.TransbankService usa las credenciales
# públicas de integración que trae el propio SDK. Recién en producción
# hacen falta credenciales de comercio reales acá.
TRANSBANK_ENVIRONMENT=integracion
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=

# Khipu NO tiene sandbox público — a diferencia de Transbank, hace falta
# crear una cuenta real en khipu.com y sacar un API key desde su panel
# (Configuración > API) para poder probarlo, incluso en desarrollo. Sin
# esto, pagar por Khipu falla con un mensaje claro en vez de un 500.
KHIPU_API_KEY=

# Flow (flow.cl) — tiene sandbox PÚBLICO: crea una cuenta de pruebas en sandbox.flow.cl
# y copia ApiKey y SecretKey desde su panel. FLOW_AMBIENTE=sandbox (default) o produccion.
# Sin las dos claves, la app no ofrece Flow como medio de pago.
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_AMBIENTE=sandbox

# Mercado Pago (Checkout Pro) — Access Token de PRUEBA ("TEST-...") desde el panel de
# desarrolladores de Mercado Pago Chile (Tus integraciones > tu aplicación > Credenciales
# de prueba). Sin él, la app no ofrece Mercado Pago. Para que lleguen las notificaciones
# la URL del backend debe ser pública (https), no localhost.
MERCADOPAGO_ACCESS_TOKEN=

# Comisión de la plataforma (%) que se muestra como referencia en la hoja
# de presupuesto opcional al confirmar una contratación — no descuenta
# nada de verdad todavía, es solo informativo.
COMISION_PLATAFORMA_PORCENTAJE=5.0

# Retención (%) de la boleta de honorarios que usa la calculadora de valorización (2027: 16). Estimación: confirmar con un contador.
# CALCULADORA_RETENCION_BOLETA=16

# --- Escaneo antivirus de archivos subidos (ver KeyServApp/antivirus.py) ---
# Apagado por defecto — requiere un daemon ClamAV corriendo en CLAMAV_HOST:CLAMAV_PORT.
CLAMAV_HABILITADO=False
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Geolocalización por IP para IntentoAccesoSospechoso (ver KeyServApp/geolocalizacion.py) ---
# Prendido por defecto — degrada solo a (None, None) si la base no está
# descargada. Bajarla con: python manage.py descargar_geoip
# GEOIP_HABILITADO=True
# GEOIP_DB_PATH=ruta absoluta al .mmdb (default: <repo>/codigo/backend/django/geoip/dbip-city-lite.mmdb)

# Claves Fernet (separadas por coma) para cifrar el vector facial en reposo. Vacío = derivada de SECRET_KEY (solo dev/demo).
BIOMETRIC_ENCRYPTION_KEYS=

# Días que vale una verificación de identidad antes de exigir repetirla (identidad.py). Default 180.
#IDENTIDAD_VIGENCIA_DIAS=180
# Exigir identidad verificada para contratar y publicar. Apagado en el demo; encender en producción real.
#EXIGIR_IDENTIDAD_VERIFICADA=False
# Claves Fernet (la primera cifra, todas descifran) para cifrar el vector facial. Ver docs/cumplimiento/rotacion-de-llaves.md
#BIOMETRIC_ENCRYPTION_KEYS=

# Asistente con IA (Fase 5). Sin clave responde con un flujo guiado sin IA. Clave en build.nvidia.com ("nvapi-...").
# Nunca la subas al repositorio ni la pegues en un chat.
#NVIDIA_API_KEY=
#LLM_MODEL=google/gemma-4-31b-it
#LLM_MODEL_RESPALDO=meta/llama-3.2-11b-vision-instruct
#LLM_BASE_URL=https://integrate.api.nvidia.com/v1
